<?xml version="1.0" encoding="utf-8"?>
<!-- The PlayStation (PS4) look: a skin over the same data as Hub. Blue wave background, a row of
     square tiles at the top with the focused one enlarged and named, its artwork faintly tinted
     behind, details and Start below, and What's New cards at the bottom. -->
<component name="HomeConsole" extends="Group">
  <interface>
    <field id="data" type="assocarray" onChange="onData" />
    <field id="action" type="assocarray" alwaysNotify="true" />
    <field id="clock" type="string" onChange="onClockText" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/components/ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/homecommon.brs" />
  <script type="text/brightscript" uri="pkg:/components/HomeConsole.brs" />
  <children>
    <Rectangle width="1280" height="720" color="0x0A2A66FF" />
    <Poster uri="pkg:/images/ps4_bg.jpg" width="1280" height="720" />
    <Group id="art" opacity="0.34">
      <Poster id="bgA" width="1280" height="720" loadDisplayMode="scaleToFill" opacity="0" loadWidth="1280" loadHeight="720" blendColor="0x8FB4FFFF" />
      <Poster id="bgB" width="1280" height="720" loadDisplayMode="scaleToFill" opacity="0" loadWidth="1280" loadHeight="720" blendColor="0x8FB4FFFF" />
    </Group>
    <Rectangle width="1280" height="720" color="0x06225A55" />

    <Group id="content">
      <Group id="cats" translation="[64,30]" />
      <Group id="strip" translation="[64,92]" />
      <Label id="tileName" color="0xECEDF0FF" opacity="0" />

      <Group id="info" translation="[64,292]">
        <Label id="kicker" />
        <Label id="title" translation="[0,26]" width="900" maxLines="1" color="0xECEDF0FF" />
        <Label id="meta" width="900" color="0xB4B7BEFF" />
        <Group id="avail" />
        <Label id="summary" width="640" wrap="true" maxLines="2" lineSpacing="4" color="0xECEDF0D8" />
        <Group id="buttons" />
      </Group>

      <Label id="cardsTitle" translation="[64,640]" color="0xECEDF0C0" text="What's New" />
      <Group id="cards" translation="[64,680]" />
    </Group>

    <Group id="corner" translation="[1216,30]">
      <Group id="avatar" />
      <Label id="clockLbl" translation="[-260,4]" width="200" horizAlign="right" color="0xECEDF0FF" />
    </Group>

    <Timer id="settleTimer" duration="0.3" />
  </children>
</component>
