<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
  <interface>
    <!-- Launch/deep-link params from main.brs, e.g. {app: "browser"} or {app: "player", kind, src, title}. -->
    <field id="launchParams" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/components/ui.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle width="1280" height="720" color="0x111419FF" />
    <!-- your wallpaper, behind everything; it dims at night -->
    <Group id="wall" scaleRotateCenter="[640,360]">
      <Poster id="wallA" uri="pkg:/images/bg.jpg" width="1280" height="720" loadDisplayMode="scaleToFill" />
      <Poster id="wallB" width="1280" height="720" loadDisplayMode="scaleToFill" opacity="0" />
    </Group>
    <Rectangle id="night" width="1280" height="720" color="0x080A0FFF" opacity="0" />

    <!-- the home look (HomeHub) goes here -->
    <Group id="homeLayer" />
    <Group id="appLayer" />

    <Group id="toast" translation="[640,28]" opacity="0">
      <Poster id="toastBg" uri="pkg:/images/pill.9.png" height="50" blendColor="0x191C22F5" />
      <Label id="toastText" height="50" vertAlign="center" horizAlign="center" color="0xECEDF0FF" />
    </Group>

    <Animation id="breathAnim" duration="48" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="breathInterp" key="[0.0, 1.0]" keyValue="[[1.0,1.0],[1.0,1.0]]" fieldToInterp="wall.scale" />
    </Animation>

    <Timer id="toastTimer" duration="3.6" />
    <Timer id="clockTimer" duration="1" repeat="true" />
    <Timer id="stateTimer" duration="90" repeat="true" />
    <Timer id="idleTimer" duration="30" repeat="true" />
  </children>
</component>
