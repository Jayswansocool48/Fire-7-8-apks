<?xml version="1.0" encoding="utf-8"?>
<!-- Network requests must run off the render thread, so every request goes through this Task. -->
<component name="HttpTask" extends="Task">
  <interface>
    <field id="url" type="string" />
    <field id="method" type="string" value="GET" />
    <field id="body" type="string" />
    <field id="timeoutMs" type="integer" value="15000" />
    <field id="response" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HttpTask.brs" />
</component>
