<?xml version="1.0" encoding="utf-8"?>
<!-- Ask the TV. Type (or say, on a voice remote) a question; the Hub server answers.
     Questions asked from the phone show up here too. -->
<component name="AskApp" extends="Group">
  <interface>
    <field id="done" type="boolean" alwaysNotify="true" />
    <field id="server" type="string" />
    <field id="params" type="assocarray" />
    <field id="remoteAsk" type="assocarray" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/components/AskApp.brs" />
  <children>
    <Rectangle width="1280" height="720" color="0x14120FFF" />
    <!-- five bars that move like a voice level: slow while listening, quick while thinking -->
    <Group id="voice" translation="[640,250]">
      <Poster id="bar0" uri="pkg:/images/bar.9.png" width="18" height="56" translation="[-86,-28]" scaleRotateCenter="[9,28]" blendColor="0xF2EADCFF" />
      <Poster id="bar1" uri="pkg:/images/bar.9.png" width="18" height="96" translation="[-46,-48]" scaleRotateCenter="[9,48]" blendColor="0xF2EADCFF" />
      <Poster id="bar2" uri="pkg:/images/bar.9.png" width="18" height="132" translation="[-6,-66]" scaleRotateCenter="[9,66]" blendColor="0xF2EADCFF" />
      <Poster id="bar3" uri="pkg:/images/bar.9.png" width="18" height="96" translation="[34,-48]" scaleRotateCenter="[9,48]" blendColor="0xF2EADCFF" />
      <Poster id="bar4" uri="pkg:/images/bar.9.png" width="18" height="56" translation="[74,-28]" scaleRotateCenter="[9,28]" blendColor="0xF2EADCFF" />
    </Group>
    <Label id="question" translation="[140,370]" width="1000" horizAlign="center" wrap="true" maxLines="2" color="0xBDB3A3FF" />
    <Label id="answer" translation="[140,414]" width="1000" horizAlign="center" wrap="true" maxLines="4" lineSpacing="6" color="0xF2EADCFF" />
    <Label id="hint" translation="[0,668]" width="1280" horizAlign="center" color="0xF2EADC88" />

    <Animation id="barAnim0" duration="2" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="barInterp0" key="[0.0, 1.0]" keyValue="[[1,1],[1,1]]" fieldToInterp="bar0.scale" />
    </Animation>
    <Animation id="barAnim1" duration="2" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="barInterp1" key="[0.0, 1.0]" keyValue="[[1,1],[1,1]]" fieldToInterp="bar1.scale" />
    </Animation>
    <Animation id="barAnim2" duration="2" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="barInterp2" key="[0.0, 1.0]" keyValue="[[1,1],[1,1]]" fieldToInterp="bar2.scale" />
    </Animation>
    <Animation id="barAnim3" duration="2" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="barInterp3" key="[0.0, 1.0]" keyValue="[[1,1],[1,1]]" fieldToInterp="bar3.scale" />
    </Animation>
    <Animation id="barAnim4" duration="2" repeat="true" easeFunction="linear">
      <Vector2DFieldInterpolator id="barInterp4" key="[0.0, 1.0]" keyValue="[[1,1],[1,1]]" fieldToInterp="bar4.scale" />
    </Animation>
    <Animation id="answerAnim" duration="0.5" easeFunction="linear">
      <FloatFieldInterpolator id="answerFade" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="answer.opacity" />
      <Vector2DFieldInterpolator id="answerMove" key="[0.0, 1.0]" keyValue="[[140,432],[140,414]]" fieldToInterp="answer.translation" />
    </Animation>
    <Timer id="startTimer" duration="0.1" />
    <Timer id="idleTimer" duration="40" />
  </children>
</component>
