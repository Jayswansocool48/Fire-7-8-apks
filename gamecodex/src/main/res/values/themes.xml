<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light system theme: the app follows it when Settings → Look is "Match my system". -->
    <style name="GameCodexTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/light_bg</item>
        <item name="android:statusBarColor">@color/light_bar</item>
        <item name="android:navigationBarColor">@color/light_bar</item>
    </style>
    <color name="light_bg">#EEF1F6</color>
    <color name="light_bar">#3A4FC4</color>
    <color name="dark_bg">#151C27</color>
    <color name="dark_bar">#1A2330</color>
    <color name="icon_bg">#2A2140</color>
</resources>
